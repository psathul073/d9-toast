{
  "name": "d9-toast",
  "version": "3.6.47",
  "description": "Customizable toast notifications for React",
  "homepage": "https://psathul073.github.io/d9-toast-docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psathul073/d9-toast.git"
  },
  "bugs": {
    "url": "https://github.com/psathul073/d9-toast/issues"
  },
  "funding": {
    "type": "donation",
    "url": "https://rzp.io/rzp/eVnJ0oP"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./toast.css": "./dist/toast.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/toast.css"
  ],
  "scripts": {
    "build": "tsup && npm run copy-css",
    "copy-css": "cpy src/toast.css dist --flat"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "keywords": [
    "react",
    "toast",
    "react-component",
    "push",
    "alert",
    "message",
    "notifications",
    "d9-toast",
    "ui"
  ],
  "license": "MIT",
  "author": "Athul PS",
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cpy-cli": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
